<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.notepad.PrimaryController">

    <top>
        <MenuBar>
            <menus>

                <Menu text="File">

    <items>
        <MenuItem text="New" onAction="#newFile"/>
        <MenuItem text="Open" onAction="#openFile"/>
        <MenuItem text="Save" onAction="#saveFile"/>
        <MenuItem text="Save As" onAction="#saveAsFile"/>
        <MenuItem text="Exit" onAction="#exitApp"/>
    </items>

</Menu>

            </menus>
        </MenuBar>
    </top>

    <center>
        <TextArea fx:id="textArea"/>
    </center>

</BorderPane>